{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality",
      "listen": "0.0.0.0",
      "listen_port": {{PORT}},
      "users": [
        {
          "uuid": "{{UUID}}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{SERVER_NAME}}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{{SERVER_NAME}}",
            "server_port": 443
          },
          "private_key": "{{PRIVATE_KEY}}",
          "short_id": [
            "{{SHORT_ID}}"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
